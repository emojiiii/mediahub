# Copy this file to .env. Never commit the populated .env file.
# Generate each key independently with a cryptographically secure random source.
# PowerShell example:
#   $bytes = [byte[]]::new(32)
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)

MEDIAHUB_IMAGE=ghcr.io/emojiiii/mediahub:latest
# Web console, JSON API, health, metrics, and other control-plane traffic.
MEDIAHUB_BIND_ADDR=0.0.0.0:3000
# Root S3 protocol endpoint for SDKs and command-line clients.
MEDIAHUB_S3_BIND_ADDR=0.0.0.0:9000
# Delay physical blob deletion after logical null-version replacement.
PRISMARK_GC_GRACE_HOURS=24
# Bearer token for the internal Watchtower HTTP API. Generate a random value
# of at least 32 characters and keep it out of source control.
MEDIAHUB_UPDATER_TOKEN=
# Optional read-only GitHub token used to inspect the latest successful build
# when the repository or workflow is not publicly readable.
MEDIAHUB_GITHUB_TOKEN=
# Optional path to a Docker registry config when MEDIAHUB_IMAGE is private.
DOCKER_CONFIG_PATH=/root/.docker/config.json
MEDIAHUB_POSTGRES_DB=mediahub
MEDIAHUB_POSTGRES_USER=mediahub
MEDIAHUB_POSTGRES_PASSWORD=

MEDIAHUB_ACCESS_KEY_MASTER_KEY=
MEDIAHUB_ACCESS_KEY_MASTER_KEY_VERSION=1
MEDIAHUB_MEDIA_SIGNING_KEY=

MEDIAHUB_RESEND_API_KEY=
MEDIAHUB_EMAIL_FROM=noreply@example.com
MEDIAHUB_WEB_URL=https://mediahub.example.com

MEDIAHUB_REGISTRATION_ENABLED=false
MEDIAHUB_CORS_ALLOWED_ORIGINS=
MEDIAHUB_ALLOW_INSECURE_COOKIES=false
MEDIAHUB_COOKIE_SAME_SITE=lax
